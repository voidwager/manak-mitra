# Frontend environment (Vite). Copy to `.env` to override.
#
# Leave this unset for normal use. The dev server proxies /api to the backend
# (vite.config.js), so the browser talks to a single origin - which is what
# makes access from another device on the network work without baking a LAN
# address into the bundle.
#
# Set it only if the API runs on a genuinely different origin:
# VITE_API_BASE_URL=http://api.example.internal/api
