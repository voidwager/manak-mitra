# SYNQ Workbench - environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must
# never be committed. Placeholders only in this file.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
DEBUG=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL is the target database for this project.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
#
# Leave DATABASE_URL empty (or commented out) to use the SQLite development
# fallback instead - handy for a first run before PostgreSQL is installed.
# The SQLite path is a convenience for local development only; it is not the
# deployment target.
#
# DATABASE_URL=postgresql+psycopg://mrpl:CHANGE_ME@localhost:5432/synq_workbench
DATABASE_URL=

SQLITE_FALLBACK_PATH=data/synq_workbench.db

# Set to true to log every SQL statement. Noisy; off by default.
SQL_ECHO=false

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Where uploaded documents are written. Relative paths resolve from the
# REPOSITORY ROOT, not the working directory, so the location is the same
# whether uvicorn is started from the repo root or from backend/.
UPLOAD_DIR=data/documents

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Model layer
# ---------------------------------------------------------------------------
# MODEL_PROVIDER selects the implementation behind the model gateway:
#   none  - inference disabled (default)
#   groq  - external provider. PROTOTYPE ONLY: while this is active the
#           system is NOT sovereign and NOT on-premise, and /api/health
#           reports that fact.
#   local - on-premise runtime (Ollama / vLLM / TGI). The end goal.
#
# Both providers use the same OpenAI-compatible wire format, so moving from
# groq to local changes these variables and nothing else.
MODEL_PROVIDER=none

# Model identifier. Provider-specific, and catalogues change over time, so
# there is no default. Ask the running provider what it serves:
#     curl http://localhost:8000/api/models
#
# This project standardises on the QWEN family. Reasons, so nobody has to
# re-litigate it later:
#   - Apache 2.0. Survives a PSU procurement review.
#   - Full size ladder (~0.5B to 72B+). The same family runs at 7B on a
#     laptop for the offline demo and at 72B on plant hardware, so prompts
#     tuned against the hosted model behave the same locally.
#   - A vision variant in the same family, which the problem statement
#     ("Open-Weight Multimodal LLMs") will need.
#
# Do NOT prototype on a closed model. Closed weights cannot run on-premise,
# which turns the final migration into a redesign instead of a config change.
MODEL_NAME=

MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=1024
MODEL_TIMEOUT_SECONDS=60

# How many previous messages of a conversation are sent as context.
MODEL_HISTORY_LIMIT=12

# --- Prototype provider (Groq) ---
# SECRET. Put the real value in .env only - never in source, never committed,
# never in the database. Get one from https://console.groq.com
# GROQ_API_KEY=your-groq-api-key-here
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- On-premise runtime ---
# Ollama's default shown. vLLM and TGI expose the same API on their own port.
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
# A second hosted vendor, reached through Google's OpenAI-compatible endpoint
# so it needs no extra dependency. Worth running alongside Groq for two
# reasons: a separate rate limit, and a much larger context window - which
# matters for document work, where the point is putting retrieved passages in
# front of the model.
#
# SECRET. .env only. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Gemma, not a Gemini Flash model, and the choice is deliberate.
#
# Gemini's own models are never released, so building on them would fail the
# open-weight requirement AND make the on-premise migration a rewrite rather
# than a config change. Gemma 4 is Apache 2.0 with weights published at
# huggingface.co/google/gemma-4-31B-it, and it is multimodal - so this route
# gets Google's serving capacity and rate limit while the model itself stays
# something you could download and host yourself.
#
# Note the `models/` prefix. Google's OpenAI-compatible endpoint returns and
# expects fully-qualified ids; a bare `gemma-4-31b-it` returns 404. List what
# your key can actually reach before setting this - the catalogue changes,
# and `gemini-2.5-flash` (the previous default here) has since been retired.
GEMINI_MODEL=models/gemma-4-31b-it

# Honest consequence: with Gemini active, inference leaves the network
# exactly as it does with Groq. /api/health reports onPremise: false for
# both, and the UI says so. Open-weight is a claim about the model; on-premise
# is a claim about where it runs. This configuration earns the first, not the
# second.

# ---------------------------------------------------------------------------
# Model routing
# ---------------------------------------------------------------------------
# One deployment, several models, chosen per turn by what the turn needs.
# All are served by the provider configured above - routing picks a model,
# never a vendor, so it sits inside the gateway seam rather than around it.
#
# Every entry is optional. An unset role falls back to MODEL_NAME and says so:
#     curl http://localhost:8000/api/models   # shows the resolved table
#
# Routing is deterministic on purpose. A turn carrying an image needs a model
# that accepts images - that is a fact about the turn, not a guess about its
# difficulty. There is no "this looks complicated" heuristic, because a router
# that switches models on a hunch cannot be debugged or explained.

# A route may name its vendor as well as its model:
#     qwen/qwen3.8-27b               the default provider
#     gemini:models/gemma-4-31b-it   explicitly Gemini
#     groq:openai/gpt-oss-120b       explicitly Groq
# Unqualified ids use MODEL_PROVIDER, so existing configuration is unchanged.
# The separator is `:` rather than `/` because model ids contain slashes.

# The working set below is entirely open-weight - Qwen and GPT-OSS publish to
# HuggingFace, Gemma 4 is Apache 2.0 - which is what the problem statement
# asks for. Splitting across two vendors also means one hitting its rate
# limit does not stop the other.

# Accepts images. Required for any turn with a picture attached; without it
# an attached image is refused with a reason rather than silently ignored.
# Gemini is the better choice here - it has the larger context and a
# separate rate limit from the chat model.
MODEL_VISION=gemini:models/gemma-4-31b-it

# Longer analysis, for agents explicitly configured for it. Gemma's 256K
# context is the reason it is here: document work means putting a lot of
# retrieved passage in front of the model.
MODEL_REASONING=gemini:models/gemma-4-31b-it

# Cheap and quick, for short turns where the large model is wasted. This also
# serves SI-1's specialist classifier, which is a one-word decision.
MODEL_FAST=openai/gpt-oss-20b

# Speech to text. Without it the microphone is disabled rather than faking
# a transcript.
MODEL_TRANSCRIPTION=whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Agentic loop
# ---------------------------------------------------------------------------
# How far an agent may work on its own before it must answer.
#
# Bounded three independent ways, because a model that gets stuck does not
# get stuck politely - it repeats a call, or walks a chain of near-identical
# ones, and each iteration costs a request and grows the context. Any one
# bound alone is escapable: a model can make ten calls inside one step, or
# one very slow call per step.
#
# Whichever binds first ends the loop, and the reason appears in the answer's
# activity trace rather than the answer simply arriving truncated.
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_TIME_BUDGET_SECONDS=90

# ---------------------------------------------------------------------------
# Retrieval (RAG)
# ---------------------------------------------------------------------------
# Retrieval has two independent halves, and only one of them needs a model.
#
#   Lexical (BM25)  - always on. Pure Python over the indexed chunks, no
#                     model, no service, no network. Uploading a document
#                     makes it searchable immediately, on a laptop, offline.
#   Semantic        - additive. Switches on when EMBEDDING_PROVIDER below is
#                     configured, and is then fused with the lexical ranking.
#
# GET /api/health reports which of the two is actually active. Nothing
# claims semantic search when no embedder answered.

RAG_ENABLED=true

# Index a document automatically as soon as it is uploaded. Turn off to
# require an explicit POST /api/documents/{id}/index.
RAG_AUTO_INDEX=true

# Chunking, in characters rather than tokens: the tokenizer belongs to
# whichever model is loaded, and depending on a model-specific tokenizer just
# to split text would put a vendor dependency underneath the gateway seam.
# Roughly 4 characters per token, so 1200 is about 300 tokens.
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=200

# How many passages a turn retrieves, and how much prompt they may occupy.
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000

# Passages scoring below this (normalised 0-1 within one result set) are
# dropped rather than padded into the prompt. A weak match is worse than no
# match: it invites the model to cite something irrelevant.
RAG_MIN_SCORE=0.05

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER selects the implementation behind the embedding gateway:
#   none  - semantic retrieval off. Lexical retrieval still works.
#   local - on-premise embedding runtime (Ollama / TEI / vLLM / Infinity)
#
# Sovereignty note: this matters more than the chat provider. Indexing sends
# the *entire* corpus to whatever endpoint is configured here, not only the
# parts someone asks about. There is deliberately no hosted option.
EMBEDDING_PROVIDER=none

# Provider-specific and catalogues change, so there is no default.
# Ollama examples: nomic-embed-text, bge-m3, qwen3-embedding:0.6b
#   ollama pull nomic-embed-text
#   ollama list
#
# Changing this invalidates existing vectors - they are not comparable across
# models - so re-index afterwards. Retrieval only uses chunks whose stored
# model matches this value, and silently falls back to keyword search for the
# rest rather than comparing incomparable vectors.
EMBEDDING_MODEL=

EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Frontend (Vite) - read at build time, so it must be prefixed with VITE_
# ---------------------------------------------------------------------------
# Base URL the browser uses to reach the API. Set this in frontend/.env
# (or leave unset to use the default below).
# VITE_API_BASE_URL=http://localhost:8000/api

# ---------------------------------------------------------------------------
# Demo credentials
# ---------------------------------------------------------------------------
# The password given to every seeded demo account. Public in this repository
# on purpose - the dataset is fictional, and a demo nobody can sign into is
# not a demo.
#
# A deployment carrying real data MUST change this before seeding, and should
# then change each account's password individually through the application.
DEMO_PASSWORD=workbench-demo
